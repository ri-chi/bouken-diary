{
  "name": "bouken-api",
  "private": true,
  "description": "ぼうけん日記のいいね・コメントを保存する Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute bouken-api --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute bouken-api --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
